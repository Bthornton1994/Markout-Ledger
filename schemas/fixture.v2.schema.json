{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bthornton1994/Markout-Ledger/schemas/fixture.v2.schema.json",
  "title": "Markout Ledger replay fixture, schema version 2",
  "description": "A fixture is JSONL: the first line matches #/$defs/header, every following line matches #/$defs/event. Version 2 adds capture provenance, instrument specification and rights (all under provenance) and per-event raw references. Version 1 (synthetic) fixtures remain valid under the version-1 rules in docs/EVENT_SCHEMA.md and are not described here. Sizes are written with decimalsOf(header.qtyScale) places: six on the current engine, eight after the precision migration of docs/M2_GROK_HANDOFF.md section 0. Unknown properties: objects accept properties they do not declare (additive, forward-compatible fields; contract sections 6 and 9), except provenance.capture.clockReports and each report in it, which are closed so that the verbatim clock report cannot enter them under another key; keeping it out of the fixture's other, open objects is the normalizer's rule (contract section 4.2), not the schema's. The schema checks presence and shape, never whether a field's content is true. See docs/M2_DATA_CONTRACT.md section 6.",
  "oneOf": [{ "$ref": "#/$defs/header" }, { "$ref": "#/$defs/event" }],
  "$defs": {
    "priceDecimal": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$", "description": "non-negative decimal with exactly six places, as written by fmtPrice" },
    "sizeDecimal": { "type": "string", "pattern": "^[0-9]+\\.([0-9]{6}|[0-9]{8})$", "description": "non-negative decimal with six places (qtyScale 1000000) or eight places (qtyScale 100000000), as written by fmtQty" },
    "plainDecimal": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,10})?$", "description": "the venue's value as a plain decimal string (exponent lexemes converted exactly), kept in instrumentSpec" },
    "ms": { "type": "integer", "minimum": 0 },
    "ns": { "type": "string", "pattern": "^[0-9]{1,20}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonBlank": { "type": "string", "pattern": "(?![\\p{Default_Ignorable_Code_Point}\\u2800\\u303F\\uFFFC\\u{13441}\\u{13442}\\u{1D159}])[\\p{L}\\p{N}\\p{P}\\p{S}]", "description": "non-blank: at least one character whose Unicode general category is a letter (L), number (N), punctuation (P) or symbol (S) and which is neither a Default_Ignorable_Code_Point nor one of the blank glyphs U+2800 BRAILLE PATTERN BLANK, U+303F IDEOGRAPHIC HALF FILL SPACE, U+FFFC OBJECT REPLACEMENT CHARACTER, U+13441 EGYPTIAN HIEROGLYPH FULL BLANK, U+13442 EGYPTIAN HIEROGLYPH HALF BLANK and U+1D159 MUSICAL SYMBOL NULL NOTEHEAD. A value made only of whitespace (every Unicode White_Space character, including U+0085 and U+00A0), separators, control or format characters (including U+200B to U+200D, U+2060 and U+FEFF), combining marks, default-ignorable fillers such as U+3164, or those blank glyphs is rejected; the character classes follow the Unicode data of the JavaScript engine that evaluates the pattern. The pattern is an ECMAScript regular expression that must be evaluated with the u flag, as Ajv compiles patterns by default; without the u flag a JavaScript engine compiles it with a different meaning that rejects ordinary text, and engines without Unicode property escapes (Python's re, for example) reject the pattern. It checks which characters are present, never whether the value is true, meaningful or legally sufficient (contract section 6.3)" },
    "software": { "type": "object", "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "commit": { "type": "string" } } },
    "softwareWithCommit": { "type": "object", "required": ["name", "version", "commit"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "commit": { "type": "string" } } },
    "clock": {
      "type": "object",
      "description": "parsed clock-sync fields only; closed to unknown keys so that the verbatim report (which names NTP servers by address) cannot enter a clock report under another key (contract section 4.2)",
      "required": ["source", "synchronized", "takenAtIso"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["chrony", "ntpd", "ptp", "platform", "unknown"] },
        "report": false,
        "offsetMs": { "type": "number" },
        "stratum": { "type": "integer" },
        "synchronized": { "type": "boolean" },
        "takenAtIso": { "type": "string", "format": "date-time" }
      }
    },
    "lagStats": { "type": "object", "required": ["count", "min", "p1", "p50", "p99", "max"], "properties": { "count": { "type": "integer", "minimum": 0 }, "min": { "type": "integer" }, "p1": { "type": "integer" }, "p50": { "type": "integer" }, "p99": { "type": "integer" }, "max": { "type": "integer" } } },
    "spanStats": { "type": "object", "required": ["p1", "p50"], "properties": { "p1": { "type": "number", "minimum": 0 }, "p50": { "type": "number", "minimum": 0 } }, "description": "distance in basis points from mid to the worst emitted level on one side, percentiles over book events" },
    "rawRef": { "type": "object", "required": ["fileIndex", "record", "element"], "properties": { "fileIndex": { "type": "integer", "minimum": 0 }, "record": { "type": "integer", "minimum": 0 }, "element": { "type": "integer", "minimum": 0 } } },
    "instrumentSpec": {
      "type": "object",
      "required": ["venueSymbol", "tickSize", "lotSize", "priceDecimals", "qtyDecimals", "costDecimals", "qtyMin", "costMin", "status", "aggressorSource", "tradeStreamGranularity", "tradeIdOrdered", "integrity", "source", "fetchedAtIso"],
      "properties": {
        "venueSymbol": { "type": "string" },
        "tickSize": { "$ref": "#/$defs/plainDecimal", "description": "the venue's price increment" },
        "lotSize": { "$ref": "#/$defs/plainDecimal", "description": "the venue's quantity increment" },
        "priceDecimals": { "type": "integer", "minimum": 0, "maximum": 6, "description": "must not exceed decimalsOf(PRICE_SCALE)" },
        "qtyDecimals": { "type": "integer", "minimum": 0, "maximum": 8, "description": "must not exceed decimalsOf(QTY_SCALE) of the normalizing engine (6 today, 8 after the precision migration)" },
        "costDecimals": { "type": "integer", "minimum": 0 },
        "qtyMin": { "$ref": "#/$defs/plainDecimal" },
        "costMin": { "$ref": "#/$defs/plainDecimal" },
        "status": { "type": "string" },
        "aggressorSource": { "enum": ["maker_flag", "taker_side", "none"] },
        "tradeStreamGranularity": { "enum": ["per_fill", "aggregated"] },
        "tradeIdOrdered": { "type": "boolean" },
        "integrity": { "enum": ["crc32_top10", "sequence", "none"], "description": "the per-message stream-position proof the adapter verifies" },
        "source": { "type": "string" },
        "fetchedAtIso": { "type": "string", "format": "date-time" }
      }
    },
    "capture": {
      "type": "object",
      "required": ["captureId", "captureFormatVersion", "rawFiles", "segmentIndex", "startReason", "endReason", "endRawRecord", "capturer", "normalizer", "adapter", "clockSync", "clockReports", "venueClockOffsetMs", "lagStatsMs", "integrity", "visibleSpanBps", "tradeIdJumps", "venueStatus", "dropped", "cuts"],
      "properties": {
        "captureId": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "description": "a lower-case UUID version 4 (contract section 3)" },
        "captureFormatVersion": { "const": 1 },
        "rawFiles": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["fileIndex", "sha256", "records"], "properties": { "fileIndex": { "type": "integer" }, "sha256": { "$ref": "#/$defs/sha256" }, "records": { "type": "integer" } } } },
        "segmentIndex": { "type": "integer", "minimum": 0 },
        "startReason": { "enum": ["capture_start", "resync_after_gap", "resync_after_clock_cut"] },
        "endReason": { "enum": ["capture_end", "checksum_mismatch", "snapshot_reset", "gap_sequence", "gap_disconnect", "clock_cut", "reconstruction_failure", "malformed_depth"] },
        "endRawRecord": { "type": "object", "required": ["fileIndex", "record"], "properties": { "fileIndex": { "type": "integer", "minimum": 0 }, "record": { "type": "integer", "minimum": 0 } } },
        "capturer": { "$ref": "#/$defs/softwareWithCommit" },
        "normalizer": { "$ref": "#/$defs/softwareWithCommit" },
        "adapter": { "$ref": "#/$defs/software" },
        "clockSync": { "enum": ["synchronized", "unknown"] },
        "clockReports": { "type": "object", "required": ["start", "end"], "additionalProperties": false, "properties": { "start": { "$ref": "#/$defs/clock" }, "end": { "$ref": "#/$defs/clock" } }, "description": "closed to unknown keys: only start and end, each a closed clock block (contract section 4.2)" },
        "venueClockOffsetMs": {
          "type": "object",
          "required": ["samples", "medianMs", "medianRttMs", "maxAbsMs", "resolutionMs", "source"],
          "properties": {
            "samples": { "type": "integer", "minimum": 0 },
            "medianMs": { "type": "number" },
            "medianRttMs": { "type": "number" },
            "maxAbsMs": { "type": "number" },
            "resolutionMs": { "enum": [1, 1000], "description": "1 for WebSocket method-response probes, 1000 for the REST Time fallback" },
            "source": { "enum": ["ws_method_response", "rest_time", "none"] }
          }
        },
        "lagStatsMs": { "type": "object", "required": ["book", "trade"], "properties": { "book": { "$ref": "#/$defs/lagStats" }, "trade": { "$ref": "#/$defs/lagStats" } } },
        "integrity": { "type": "object", "required": ["checksumsVerified", "checksumMismatches"], "properties": { "checksumsVerified": { "type": "integer", "minimum": 0 }, "checksumMismatches": { "type": "integer", "minimum": 0, "maximum": 1, "description": "1 only for a segment ended by checksum_mismatch" } } },
        "visibleSpanBps": { "type": "object", "required": ["bid", "ask"], "properties": { "bid": { "$ref": "#/$defs/spanStats" }, "ask": { "$ref": "#/$defs/spanStats" } } },
        "tradeIdJumps": { "type": "integer", "minimum": 0 },
        "venueStatus": { "type": "array", "items": { "type": "object", "required": ["record", "source", "value"], "properties": { "record": { "$ref": "#/$defs/rawRef" }, "source": { "enum": ["status", "instrument"] }, "value": { "type": "string" } } }, "description": "status frames whose system is not online, and instrument updates that change this pair's status" },
        "dropped": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "cuts": { "type": "array", "items": { "type": "object", "required": ["reason", "fileIndex", "record"], "properties": { "reason": { "type": "string" }, "fileIndex": { "type": "integer" }, "record": { "type": "integer" }, "detail": { "type": "string" } } } },
        "vendor": { "type": "object", "required": ["name", "captureLocation", "licence"], "properties": { "name": { "type": "string" }, "captureLocation": { "type": "string" }, "licence": { "type": "string" } }, "description": "required when provenance.timeBasis.obsTime is third_party_receive (a basis this build rejects)" }
      }
    },
    "rights": {
      "type": "object",
      "required": ["termsUrl", "termsCheckedOn", "checkedBy", "redistribution", "publication"],
      "properties": {
        "termsUrl": { "$ref": "#/$defs/nonBlank" },
        "termsCheckedOn": { "type": "string", "format": "date" },
        "checkedBy": { "$ref": "#/$defs/nonBlank" },
        "redistribution": { "enum": ["permitted", "prohibited", "unclear"] },
        "publication": { "enum": ["hash_only", "sample_permitted"] },
        "note": { "$ref": "#/$defs/nonBlank", "description": "non-blank when present; required when redistribution is permitted, where it identifies the owner's nonprivileged attestation on pull request #3 that records the clearance of publishing recorded data under decision condition C2 (date, source, scope, outcome). The schema checks presence and shape only; whether the attested record exists and clears that scope is the owner's manual verification (docs/M2_DATA_CONTRACT.md section 6.3)" }
      },
      "allOf": [
        {
          "if": { "properties": { "publication": { "const": "sample_permitted" } }, "required": ["publication"] },
          "then": { "properties": { "redistribution": { "const": "permitted" } } }
        },
        {
          "if": { "properties": { "redistribution": { "const": "permitted" } }, "required": ["redistribution"] },
          "then": { "required": ["note"], "properties": { "note": true } }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "required": ["source", "description", "timeBasis"],
      "properties": {
        "source": { "enum": ["synthetic", "recorded"] },
        "description": { "type": "string" },
        "generator": { "type": "string" },
        "generatorVersion": { "type": "string" },
        "seed": { "type": "integer" },
        "recordedFrom": { "type": "string" },
        "captureMethod": { "type": "string" },
        "timeBasis": {
          "type": "object",
          "required": ["obsTime", "marketTime"],
          "properties": { "obsTime": { "type": "string" }, "marketTime": { "type": "string" } }
        },
        "instrumentSpec": { "$ref": "#/$defs/instrumentSpec" },
        "capture": { "$ref": "#/$defs/capture" },
        "rights": { "$ref": "#/$defs/rights" }
      }
    },
    "header": {
      "type": "object",
      "required": ["type", "schemaVersion", "symbol", "venue", "venueSymbol", "priceScale", "qtyScale", "tickSize", "lotSize", "startTime", "endTime", "eventCount", "synthetic", "depth", "provenance"],
      "properties": {
        "type": { "const": "header" },
        "schemaVersion": { "const": 2 },
        "symbol": { "type": "string" },
        "venue": { "type": "string" },
        "venueSymbol": { "type": "string" },
        "priceScale": { "const": 1000000 },
        "qtyScale": { "enum": [1000000, 100000000] },
        "tickSize": { "$ref": "#/$defs/priceDecimal" },
        "lotSize": { "$ref": "#/$defs/sizeDecimal" },
        "startTime": { "$ref": "#/$defs/ms" },
        "endTime": { "$ref": "#/$defs/ms" },
        "eventCount": { "type": "integer", "minimum": 0 },
        "synthetic": { "type": "boolean" },
        "syntheticLabel": { "type": "string" },
        "depth": { "type": "integer", "minimum": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "allOf": [
        {
          "if": { "properties": { "synthetic": { "const": false } }, "required": ["synthetic"] },
          "then": {
            "type": "object",
            "properties": {
              "provenance": {
                "type": "object",
                "required": ["recordedFrom", "captureMethod", "instrumentSpec", "capture", "rights"],
                "properties": {
                  "recordedFrom": true,
                  "captureMethod": true,
                  "instrumentSpec": true,
                  "capture": true,
                  "rights": true,
                  "source": { "const": "recorded" },
                  "timeBasis": { "type": "object", "properties": { "obsTime": { "enum": ["capture_receive", "third_party_receive"] } } }
                },
                "allOf": [
                  {
                    "if": { "properties": { "timeBasis": { "type": "object", "properties": { "obsTime": { "const": "third_party_receive" } }, "required": ["obsTime"] } }, "required": ["timeBasis"] },
                    "then": { "type": "object", "properties": { "capture": { "type": "object", "required": ["vendor"], "properties": { "vendor": true } } } }
                  }
                ]
              }
            }
          },
          "else": {
            "type": "object",
            "required": ["syntheticLabel"],
            "properties": {
              "syntheticLabel": { "const": "SYNTHETIC DATA: generated by a seeded simulator. Not real market data. Results derived from it are research output only and imply nothing about live profitability." },
              "provenance": { "type": "object", "properties": { "source": { "const": "synthetic" } } }
            }
          }
        }
      ]
    },
    "eventBase": {
      "type": "object",
      "required": ["type", "eventId", "seq", "obsTime", "marketTime", "symbol", "venue"],
      "properties": {
        "type": { "enum": ["book", "trade"] },
        "eventId": { "type": "string" },
        "seq": { "type": "integer", "minimum": 0 },
        "obsTime": { "$ref": "#/$defs/ms" },
        "marketTime": { "$ref": "#/$defs/ms" },
        "blockNumber": { "type": "integer" },
        "symbol": { "type": "string" },
        "venue": { "type": "string" },
        "venueSeq": { "type": "string" },
        "rawRef": { "$ref": "#/$defs/rawRef" },
        "recvMonoNs": { "$ref": "#/$defs/ns" }
      }
    },
    "level": { "type": "object", "required": ["price", "size"], "properties": { "price": { "$ref": "#/$defs/priceDecimal" }, "size": { "$ref": "#/$defs/sizeDecimal" } } },
    "event": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/eventBase" },
            { "type": "object", "properties": { "type": { "const": "book" }, "bids": { "type": "array", "items": { "$ref": "#/$defs/level" } }, "asks": { "type": "array", "items": { "$ref": "#/$defs/level" } } }, "required": ["type", "bids", "asks"] }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/eventBase" },
            { "type": "object", "properties": { "type": { "const": "trade" }, "tradeId": { "type": "string" }, "price": { "$ref": "#/$defs/priceDecimal" }, "size": { "$ref": "#/$defs/sizeDecimal" }, "aggressor": { "enum": ["buy", "sell", "unknown"] } }, "required": ["type", "tradeId", "price", "size", "aggressor"] }
          ]
        }
      ]
    }
  }
}
