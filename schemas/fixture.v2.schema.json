{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bthornton1994/Markout-Ledger/schemas/fixture.v2.schema.json",
  "title": "Markout Ledger replay fixture, schema version 2",
  "description": "A fixture is JSONL: the first line matches #/$defs/header, every following line matches #/$defs/event. Version 2 adds capture provenance, instrument specification and rights (all under provenance) and per-event raw references. Version 1 (synthetic) fixtures remain valid under the version-1 rules in docs/EVENT_SCHEMA.md and are not described here. See docs/M2_DATA_CONTRACT.md section 6.",
  "oneOf": [{ "$ref": "#/$defs/header" }, { "$ref": "#/$defs/event" }],
  "$defs": {
    "decimal": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{6}$", "description": "non-negative decimal with exactly six places, as written by fmtPrice/fmtQty" },
    "verbatimDecimal": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,8})?$", "description": "the venue's own decimal string, kept verbatim in instrumentSpec" },
    "ms": { "type": "integer", "minimum": 0 },
    "ns": { "type": "string", "pattern": "^[0-9]{1,20}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "software": { "type": "object", "required": ["name", "version"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "commit": { "type": "string" } } },
    "softwareWithCommit": { "type": "object", "required": ["name", "version", "commit"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "commit": { "type": "string" } } },
    "clock": {
      "type": "object",
      "required": ["source", "synchronized", "takenAtIso"],
      "properties": {
        "source": { "enum": ["chrony", "ntpd", "ptp", "platform", "unknown"] },
        "report": { "type": "string" },
        "offsetMs": { "type": "number" },
        "stratum": { "type": "integer" },
        "synchronized": { "type": "boolean" },
        "takenAtIso": { "type": "string", "format": "date-time" }
      }
    },
    "lagStats": { "type": "object", "required": ["count", "min", "p1", "p50", "p99", "max"], "properties": { "count": { "type": "integer", "minimum": 0 }, "min": { "type": "integer" }, "p1": { "type": "integer" }, "p50": { "type": "integer" }, "p99": { "type": "integer" }, "max": { "type": "integer" } } },
    "rawRef": { "type": "object", "required": ["fileIndex", "record", "element"], "properties": { "fileIndex": { "type": "integer", "minimum": 0 }, "record": { "type": "integer", "minimum": 0 }, "element": { "type": "integer", "minimum": 0 } } },
    "instrumentSpec": {
      "type": "object",
      "required": ["tickSize", "lotSize", "priceDecimals", "qtyDecimals", "aggressorSource", "tradeStreamGranularity", "tradeIdOrdered", "source", "fetchedAtIso"],
      "properties": {
        "tickSize": { "$ref": "#/$defs/verbatimDecimal" },
        "lotSize": { "$ref": "#/$defs/verbatimDecimal" },
        "priceDecimals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "qtyDecimals": { "type": "integer", "minimum": 0, "maximum": 6 },
        "aggressorSource": { "enum": ["maker_flag", "taker_side", "none"] },
        "tradeStreamGranularity": { "enum": ["per_fill", "aggregated"] },
        "tradeIdOrdered": { "type": "boolean" },
        "source": { "type": "string" },
        "fetchedAtIso": { "type": "string", "format": "date-time" }
      }
    },
    "capture": {
      "type": "object",
      "required": ["captureId", "captureFormatVersion", "rawFiles", "segmentIndex", "startReason", "endReason", "endRawRecord", "capturer", "normalizer", "adapter", "clockSync", "clockReports", "venueClockOffsetMs", "lagStatsMs", "dropped", "cuts"],
      "properties": {
        "captureId": { "type": "string", "format": "uuid" },
        "captureFormatVersion": { "const": 1 },
        "rawFiles": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["fileIndex", "sha256", "records"], "properties": { "fileIndex": { "type": "integer" }, "sha256": { "$ref": "#/$defs/sha256" }, "records": { "type": "integer" } } } },
        "segmentIndex": { "type": "integer", "minimum": 0 },
        "startReason": { "enum": ["capture_start", "resync_after_gap", "resync_after_clock_cut"] },
        "endReason": { "enum": ["capture_end", "gap_sequence", "gap_disconnect", "clock_cut", "reconstruction_failure", "malformed_depth"] },
        "endRawRecord": { "type": "object", "required": ["fileIndex", "record"], "properties": { "fileIndex": { "type": "integer", "minimum": 0 }, "record": { "type": "integer", "minimum": 0 } } },
        "capturer": { "$ref": "#/$defs/softwareWithCommit" },
        "normalizer": { "$ref": "#/$defs/softwareWithCommit" },
        "adapter": { "$ref": "#/$defs/software" },
        "clockSync": { "enum": ["synchronized", "unknown"] },
        "clockReports": { "type": "object", "required": ["start", "end"], "properties": { "start": { "$ref": "#/$defs/clock" }, "end": { "$ref": "#/$defs/clock" } } },
        "venueClockOffsetMs": { "type": "object", "required": ["samples", "medianMs", "medianRttMs", "maxAbsMs"], "properties": { "samples": { "type": "integer", "minimum": 0 }, "medianMs": { "type": "number" }, "medianRttMs": { "type": "number" }, "maxAbsMs": { "type": "number" } } },
        "lagStatsMs": { "type": "object", "required": ["book", "trade"], "properties": { "book": { "$ref": "#/$defs/lagStats" }, "trade": { "$ref": "#/$defs/lagStats" } } },
        "dropped": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "cuts": { "type": "array", "items": { "type": "object", "required": ["reason", "fileIndex", "record"], "properties": { "reason": { "type": "string" }, "fileIndex": { "type": "integer" }, "record": { "type": "integer" }, "detail": { "type": "string" } } } },
        "vendor": { "type": "object", "required": ["name", "captureLocation", "licence"], "properties": { "name": { "type": "string" }, "captureLocation": { "type": "string" }, "licence": { "type": "string" } }, "description": "required when provenance.timeBasis.obsTime is third_party_receive (a basis this build rejects)" }
      }
    },
    "rights": {
      "type": "object",
      "required": ["termsUrl", "termsCheckedOn", "checkedBy", "redistribution", "publication"],
      "properties": {
        "termsUrl": { "type": "string" },
        "termsCheckedOn": { "type": "string", "format": "date" },
        "checkedBy": { "type": "string" },
        "redistribution": { "enum": ["permitted", "prohibited", "unclear"] },
        "publication": { "enum": ["hash_only", "sample_permitted"] },
        "note": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["source", "description", "timeBasis"],
      "properties": {
        "source": { "enum": ["synthetic", "recorded"] },
        "description": { "type": "string" },
        "generator": { "type": "string" },
        "generatorVersion": { "type": "string" },
        "seed": { "type": "integer" },
        "recordedFrom": { "type": "string" },
        "captureMethod": { "type": "string" },
        "timeBasis": {
          "type": "object",
          "required": ["obsTime", "marketTime"],
          "properties": { "obsTime": { "type": "string" }, "marketTime": { "type": "string" } }
        },
        "instrumentSpec": { "$ref": "#/$defs/instrumentSpec" },
        "capture": { "$ref": "#/$defs/capture" },
        "rights": { "$ref": "#/$defs/rights" }
      }
    },
    "header": {
      "type": "object",
      "required": ["type", "schemaVersion", "symbol", "venue", "venueSymbol", "priceScale", "qtyScale", "tickSize", "lotSize", "startTime", "endTime", "eventCount", "synthetic", "depth", "provenance"],
      "properties": {
        "type": { "const": "header" },
        "schemaVersion": { "const": 2 },
        "symbol": { "type": "string" },
        "venue": { "type": "string" },
        "venueSymbol": { "type": "string" },
        "priceScale": { "const": 1000000 },
        "qtyScale": { "const": 1000000 },
        "tickSize": { "$ref": "#/$defs/decimal" },
        "lotSize": { "$ref": "#/$defs/decimal" },
        "startTime": { "$ref": "#/$defs/ms" },
        "endTime": { "$ref": "#/$defs/ms" },
        "eventCount": { "type": "integer", "minimum": 0 },
        "synthetic": { "type": "boolean" },
        "syntheticLabel": { "type": "string" },
        "depth": { "type": "integer", "minimum": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "allOf": [
        {
          "if": { "properties": { "synthetic": { "const": false } }, "required": ["synthetic"] },
          "then": {
            "type": "object",
            "properties": {
              "provenance": {
                "type": "object",
                "required": ["recordedFrom", "captureMethod", "instrumentSpec", "capture", "rights"],
                "properties": {
                  "recordedFrom": true,
                  "captureMethod": true,
                  "instrumentSpec": true,
                  "capture": true,
                  "rights": true,
                  "source": { "const": "recorded" },
                  "timeBasis": { "type": "object", "properties": { "obsTime": { "enum": ["capture_receive", "third_party_receive"] } } }
                },
                "allOf": [
                  {
                    "if": { "properties": { "timeBasis": { "type": "object", "properties": { "obsTime": { "const": "third_party_receive" } }, "required": ["obsTime"] } }, "required": ["timeBasis"] },
                    "then": { "type": "object", "properties": { "capture": { "type": "object", "required": ["vendor"], "properties": { "vendor": true } } } }
                  }
                ]
              }
            }
          },
          "else": {
            "type": "object",
            "required": ["syntheticLabel"],
            "properties": {
              "syntheticLabel": { "const": "SYNTHETIC DATA: generated by a seeded simulator. Not real market data. Results derived from it are research output only and imply nothing about live profitability." },
              "provenance": { "type": "object", "properties": { "source": { "const": "synthetic" } } }
            }
          }
        }
      ]
    },
    "eventBase": {
      "type": "object",
      "required": ["type", "eventId", "seq", "obsTime", "marketTime", "symbol", "venue"],
      "properties": {
        "type": { "enum": ["book", "trade"] },
        "eventId": { "type": "string" },
        "seq": { "type": "integer", "minimum": 0 },
        "obsTime": { "$ref": "#/$defs/ms" },
        "marketTime": { "$ref": "#/$defs/ms" },
        "blockNumber": { "type": "integer" },
        "symbol": { "type": "string" },
        "venue": { "type": "string" },
        "venueSeq": { "type": "string" },
        "rawRef": { "$ref": "#/$defs/rawRef" },
        "recvMonoNs": { "$ref": "#/$defs/ns" }
      }
    },
    "level": { "type": "object", "required": ["price", "size"], "properties": { "price": { "$ref": "#/$defs/decimal" }, "size": { "$ref": "#/$defs/decimal" } } },
    "event": {
      "oneOf": [
        {
          "allOf": [
            { "$ref": "#/$defs/eventBase" },
            { "type": "object", "properties": { "type": { "const": "book" }, "bids": { "type": "array", "items": { "$ref": "#/$defs/level" } }, "asks": { "type": "array", "items": { "$ref": "#/$defs/level" } } }, "required": ["type", "bids", "asks"] }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/eventBase" },
            { "type": "object", "properties": { "type": { "const": "trade" }, "tradeId": { "type": "string" }, "price": { "$ref": "#/$defs/decimal" }, "size": { "$ref": "#/$defs/decimal" }, "aggressor": { "enum": ["buy", "sell", "unknown"] } }, "required": ["type", "tradeId", "price", "size", "aggressor"] }
          ]
        }
      ]
    }
  }
}
