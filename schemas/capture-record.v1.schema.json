{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bthornton1994/Markout-Ledger/schemas/capture-record.v1.schema.json",
  "title": "Markout Ledger raw capture record (capture format v1)",
  "description": "One JSONL line of a first-party market-data capture. Every record carries the capture host's realtime clock in integer milliseconds (recvWallMs, from Date.now()) and its monotonic clock in nanoseconds (recvMonoNs, from process.hrtime.bigint(), as a decimal string), both read afresh for each record: a message record's by its frame handler at receipt before parsing, a probe record's at receipt of the REST response, a subscribe/unsubscribe/ping record's at send time, and every other record's (ws_open, ws_close, ws_error, note, file_start, file_end, manifest_start, manifest_end) when that record is written, never a timer's deadline; a monotonic reading that does not exceed the previous record's recvMonoNs is taken again until it does (contract section 4). Payloads are verbatim. The detail of ws_open, ws_close and ws_error takes only the values of the lifecycle table of contract section 8.1; a note's detail is free text. Records accept properties they do not declare (additive fields; contract section 6), except manifest_start.host, which is closed so that the host block carries only os and runtime, never the capture host's hostname or address (contract section 4.1). Venue-agnostic; see docs/M2_DATA_CONTRACT.md section 4.",
  "type": "object",
  "required": ["type", "recvWallMs", "recvMonoNs"],
  "properties": {
    "type": {
      "enum": ["manifest_start", "file_start", "ws_open", "ws_close", "ws_error", "subscribe", "unsubscribe", "ping", "message", "probe", "note", "file_end", "manifest_end"]
    },
    "recvWallMs": { "type": "integer", "minimum": 0 },
    "recvMonoNs": { "$ref": "#/$defs/ns" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "manifest_start" } }, "required": ["type"] },
      "then": {
        "type": "object",
        "required": ["captureFormatVersion", "captureId", "venue", "instrument", "streams", "endpoints", "capturer", "host", "clock", "instrumentSpec", "startedAtIso"],
        "properties": {
          "captureFormatVersion": { "const": 1 },
          "captureId": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$", "description": "a lower-case UUID version 4 (contract section 3)" },
          "venue": { "type": "string" },
          "instrument": { "type": "string", "description": "venue-native symbol, e.g. BTC/USD" },
          "streams": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "the subscription requests, verbatim" },
          "endpoints": { "type": "object", "required": ["ws", "rest"], "properties": { "ws": { "type": "string" }, "rest": { "type": "string" } } },
          "capturer": { "$ref": "#/$defs/softwareWithCommit" },
          "host": { "type": "object", "required": ["os", "runtime"], "properties": { "os": { "type": "string" }, "runtime": { "type": "string" } }, "additionalProperties": false },
          "clock": { "$ref": "#/$defs/clock" },
          "instrumentSpec": { "$ref": "#/$defs/instrumentSpecRaw" },
          "startedAtIso": { "type": "string", "format": "date-time" }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "file_start" } }, "required": ["type"] },
      "then": { "type": "object", "required": ["fileIndex", "previousFileSha256"], "properties": { "fileIndex": { "type": "integer", "minimum": 1 }, "previousFileSha256": { "$ref": "#/$defs/sha256" } } }
    },
    {
      "if": { "properties": { "type": { "const": "note" } }, "required": ["type"] },
      "then": { "type": "object", "required": ["detail"], "properties": { "detail": { "type": "string", "description": "operator or tool note (clock step detected, checksum mismatch, crossed book, malformed update, resubscribe issued); no book-frame check runs, and so no checksum-mismatch, crossed-book, malformed-update or resubscribe note is written, while a resync is outstanding; clock-step notes are still written (docs/M2_DATA_CONTRACT.md section 8.1)" } } }
    },
    {
      "if": { "properties": { "type": { "const": "ws_open" } }, "required": ["type"] },
      "then": { "type": "object", "required": ["detail"], "properties": { "detail": { "const": "open" } } }
    },
    {
      "if": { "properties": { "type": { "const": "ws_error" } }, "required": ["type"] },
      "then": {
        "type": "object",
        "required": ["detail"],
        "properties": { "detail": { "enum": ["connect_failed", "connect_timeout", "network_error", "subscribe_rejected", "resync_budget_exhausted", "reconnect_budget_exhausted", "capture_end", "operator_stop"] } },
        "description": "the lifecycle table of contract section 8.1 fixes every value"
      }
    },
    {
      "if": { "properties": { "type": { "const": "ws_close" } }, "required": ["type"] },
      "then": {
        "type": "object",
        "required": ["detail"],
        "properties": { "detail": { "type": "string", "pattern": "^(resync_failed|snapshot_timeout|subscribe_ack_timeout|instrument_snapshot_timeout|liveness_timeout|network_error|subscribe_rejected|budget_exhausted|capture_end|operator_stop|remote_close:[1-4][0-9]{3}|connection_lost:[1-4][0-9]{3})$" } },
        "description": "the lifecycle table of contract section 8.1 fixes every value; remote_close and connection_lost carry the close code the runtime reported (connection_lost when the close was not clean, 1006 included)"
      }
    },
    {
      "if": { "properties": { "type": { "enum": ["subscribe", "unsubscribe", "ping"] } }, "required": ["type"] },
      "then": { "type": "object", "required": ["request"], "properties": { "request": { "type": "string", "description": "verbatim text sent; written at send time (the record's clocks are the send clocks); the venue's response is a later message record matched by req_id" } } }
    },
    {
      "if": { "properties": { "type": { "const": "message" } }, "required": ["type"] },
      "then": { "type": "object", "required": ["stream", "payload"], "properties": { "stream": { "type": "string", "description": "the frame's channel, or method:<name> for method responses, or unknown" }, "payload": { "type": "string" }, "encoding": { "enum": ["utf8", "base64"] } } }
    },
    {
      "if": { "properties": { "type": { "const": "probe" } }, "required": ["type"] },
      "then": { "type": "object", "required": ["url", "sentWallMs", "sentMonoNs", "payload"], "properties": { "url": { "type": "string" }, "sentWallMs": { "type": "integer", "minimum": 0 }, "sentMonoNs": { "$ref": "#/$defs/ns" }, "payload": { "type": "string" } }, "description": "REST venue-clock probe (coarse, every 10 minutes); the record's own clocks are the response receive time" }
    },
    {
      "if": { "properties": { "type": { "const": "file_end" } }, "required": ["type"] },
      "then": { "type": "object", "required": ["fileIndex", "records", "sha256"], "properties": { "fileIndex": { "type": "integer", "minimum": 0 }, "records": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/sha256" } } }
    },
    {
      "if": { "properties": { "type": { "const": "manifest_end" } }, "required": ["type"] },
      "then": {
        "type": "object",
        "required": ["endedAtIso", "clock", "counts", "files", "processingMs"],
        "properties": {
          "endedAtIso": { "type": "string", "format": "date-time" },
          "clock": { "$ref": "#/$defs/clock" },
          "counts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
          "files": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["fileIndex", "sha256", "records"], "properties": { "fileIndex": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" }, "records": { "type": "integer", "minimum": 1 } } } },
          "processingMs": { "type": "object", "required": ["p50", "p99", "max"], "properties": { "p50": { "type": "number", "minimum": 0 }, "p99": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } }, "description": "required: frame-handler duration percentiles in milliseconds over every received frame (contract section 2), so the delay the live checks can add to the next receive stamp is auditable; all three are 0 when no frame was received" }
        }
      }
    }
  ],
  "$defs": {
    "ns": { "type": "string", "pattern": "^[0-9]{1,20}$", "description": "integer nanoseconds as a decimal string" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "softwareWithCommit": { "type": "object", "required": ["name", "version", "commit"], "properties": { "name": { "type": "string" }, "version": { "type": "string" }, "commit": { "type": "string" } } },
    "clock": {
      "type": "object",
      "required": ["source", "synchronized", "takenAtIso"],
      "properties": {
        "source": { "enum": ["chrony", "ntpd", "ptp", "platform", "unknown"] },
        "report": { "type": "string", "description": "verbatim tool output, e.g. chronyc tracking" },
        "offsetMs": { "type": "number" },
        "stratum": { "type": "integer" },
        "synchronized": { "type": "boolean" },
        "takenAtIso": { "type": "string", "format": "date-time" }
      }
    },
    "instrumentSpecRaw": {
      "type": "object",
      "required": ["source", "fetchedAtIso", "payload"],
      "properties": { "source": { "type": "string", "description": "the REST URL fetched, e.g. https://api.kraken.com/0/public/AssetPairs?pair=XBTUSD" }, "fetchedAtIso": { "type": "string", "format": "date-time" }, "payload": { "type": "string", "description": "verbatim instrument response; the instrument channel snapshot in the stream is the second source and both must agree (contract section 8.4)" } }
    }
  }
}
